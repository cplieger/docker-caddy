# Minimal example Caddyfile for ghcr.io/cplieger/docker-caddy.
#
# Copy this file to `caddy/Caddyfile`, then edit it for your sites. compose.yaml
# mounts the ./caddy folder at /etc/caddy.
#     mkdir -p caddy && cp Caddyfile.example caddy/Caddyfile
#
# Caddyfile.plugins.example has a site block that uses the bundled plugins and
# the two credentials it needs. docs/troubleshooting.md, "Check the serving
# path too", shows a healthcheck override that probes the /health route below.
{
	# Deliberate: the image healthcheck probes 127.0.0.1:2019, and this
	# directive outranks the CADDY_ADMIN env var (which only supplies the
	# default used when no admin address is configured).
	admin localhost:2019
}

# /health must live in an explicit `http://:80` block: Caddy auto-redirects :80 -> :443
# for HTTPS site blocks, so a /health route inside one would 308 rather than answer.
http://:80 {
	respond /health "OK" 200
}
